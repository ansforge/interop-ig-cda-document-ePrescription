           fhir:v "https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-dispensation-medicaments|0.1.0"^^xsd:anyURI ;
           fhir:link <https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-dispensation-medicaments|0.1.0>
         ] )
       ] )
     ] [
       fhir:id [ fhir:v "ClinicalDocument.component.structuredBody.component.section.title" ] ;
       fhir:path [ fhir:v "ClinicalDocument.component.structuredBody.component.section.title" ] ;
       fhir:short [ fhir:v "Fixé à \"Médicaments délivrés\"." ]
     ] [
       fhir:id [ fhir:v "ClinicalDocument.component.structuredBody.component.section.title.xmlText" ] ;
       fhir:path [ fhir:v "ClinicalDocument.component.structuredBody.component.section.title.xmlText" ] ;
       fhir:pattern [
         a fhir:string ;
         fhir:v "Médicaments délivrés"
       ]
     ] [
       fhir:id [ fhir:v "ClinicalDocument.component.structuredBody.component.section.text" ] ;
       fhir:path [ fhir:v "ClinicalDocument.component.structuredBody.component.section.text" ] ;
       fhir:short [ fhir:v "Dispensations sous forme textuelle : médicaments dispensés et posologie." ]
     ] [
       fhir:id [ fhir:v "ClinicalDocument.component.structuredBody.component.section.author" ] ;
       fhir:path [ fhir:v "ClinicalDocument.component.structuredBody.component.section.author" ] ;
       fhir:short [ fhir:v "[EXTENSION FR] Dispensateur (pharmacien) : obligatoire car en France l'auteur du document est le Dossier Pharmaceutique, le dispensateur est donc mentionné au niveau de la section." ]
     ] [
       fhir:id [ fhir:v "ClinicalDocument.component.structuredBody.component.section.entry" ] ;
       fhir:path [ fhir:v "ClinicalDocument.component.structuredBody.component.section.entry" ] ;
       fhir:short [ fhir:v "[EXTENSION FR] Entrées FR-Traitement-dispense : une par médicament dispensé (les spécifications internationales n'en autorisent qu'une). Chaque entrée contient le médicament dispensé et, le cas échéant : la référence à la ligne de prescription (FR-Reference-item-prescription, code PREItem), les instructions au patient, les notes du dispensateur, la posologie uniquement si elle a été modifiée (FR-Traitement, consumable valorisé avec nullFlavor=\"NA\") et l'acte de substitution uniquement si le médicament prescrit a été substitué." ]
     ] )
  ] . # 

